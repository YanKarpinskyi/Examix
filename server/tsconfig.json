{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "noEmit": true,

    "types": ["node"],
    "sourceMap": true,
    "ignoreDeprecations": "6.0",

    "baseUrl": ".",
    "paths": {
      "@zno/shared": ["../shared/types/index.ts"]
    },

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true
  }
}